# ==============================================================================
# ARTISAN LEDGER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or production secret values to version control.
# ==============================================================================

# Session & Security (Required: at least 32-character random string)
SESSION_SECRET=artisan_ledger_secure_session_token_32chars_sample_change_in_prod

# OpenAI API Key (Optional: enables natural language intent-to-invoice drafting)
OPENAI_API_KEY=

# Resend API (Optional: transactional email dispatch via Resend)
RESEND_API_KEY=
EMAIL_FROM="Artisan Ledger <onboarding@resend.dev>"

# Gmail SMTP Dispatch (Optional: alternative to Resend for sending via Google App Password)
SMTP_USER=
SMTP_PASS=

# Server & Database Settings
PORT=3000
NODE_ENV=production
APP_URL=https://artledger.link
# DATABASE_URL=/app/data/ledger.db
